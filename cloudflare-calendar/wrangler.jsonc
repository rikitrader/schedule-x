{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mipolitico-calendar",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "calendar.mipolitico.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "CALENDAR_DB",
      "database_name": "mipolitico-calendar",
      "database_id": "f3acbb4c-9491-4fd3-b5fd-ab882e9b63d5",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "CRM_SERVICE",
      "service": "twenty-crm"
    },
    // Project-hub SSO: MiPolitico's own hub only.
    { "binding": "HUB", "service": "mipolitico-hub", "entrypoint": "HubRpc" }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "CRM_WEBHOOK_URL": "https://crm.mipolitico.com/api/integrations/calendar/webhook",
    "HUB_PROJECT": "mipolitico",
    "HUB_LOGIN_URL": "https://hub.mipolitico.com/login?next=/go/calendar",
    // "false": hub sign-in works and the shared admin password stays as a fallback. Set "true" once hub SSO is verified.
    "HUB_REQUIRED": "false"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
